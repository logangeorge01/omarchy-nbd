# Local test/hosting infrastructure -- nginx binary distribution, the
# hardlinked ISO, extracted vmlinuz/initrd, Hyper-V test disks. None of
# this is project source; real hosting now lives on lagsoftware.com/files
# and the GitHub Release. See docs/ARCHITECTURE.md.
/hosting/

# Build artifacts -- rebuild via bridge/scripts/build-static.sh.
/bridge/omarchy-nbd-bridge
/bridge/cmd/omarchy-nbd-bridge/omarchy-nbd-bridge.exe

# Editor swap files.
*.swp

# Test/investigation run output -- regenerated by bridge/scripts/*.sh.
/bridge/scripts/*.log
/bridge/scripts/*-dump-output.txt

# One-off ISO/initrd/installer investigation scripts and their dumps, kept
# locally for reference but not part of the project's deliverable --
# installer-dump.txt and configurator-dump.txt specifically contain
# verbatim copies of Omarchy's own (GPL-licensed) source, not ours to
# redistribute here.
/bridge/scripts/check-initrd.sh
/bridge/scripts/full-initrd-dump.sh
/bridge/scripts/find-seg2.py
/bridge/scripts/find-installer.sh
/bridge/scripts/extract-installer.sh
/bridge/scripts/find-configurator.sh
/bridge/scripts/extract-configurator.sh
/bridge/scripts/installer-dump.txt
/bridge/scripts/configurator-dump.txt
